ine-block;padding:12px 26px;font-size:15px;font-weight:600;border:2px solid var(--teal)}\n.btn-solid{background:var(--teal);color:#fff}\n.btn-solid:hover{background:var(--teal-deep);text-decoration:none}\n.btn-ghost{color:var(--teal-deep);background:transparent}\n.btn-ghost:hover{background:var(--teal-soft);text-decoration:none}\n.hero-blank{border:1px dashed var(--line);min-height:220px;display:flex;align-items:flex-end;justify-content:flex-end;padding:18px;color:#aeb9c1;font-size:12px;letter-spacing:.3em;writing-mode:vertical-rl}\n\n/* ---------- 通用区块 ---------- */\nsection{padding:64px 0}\n.sec-head{margin-bottom:36px;max-width:640px}\n.sec-head .no{font-size:13px;color:var(--teal-deep);letter-spacing:.25em;font-weight:700;display:block;margin-bottom:8px}\nh2{font-size:clamp(24px,3.4vw,32px);color:var(--slate);line-height:1.3;margin-bottom:10px}\n.sec-head p{color:var(--slate-3);font-size:15px}\nh3{font-size:18px;color:var(--slate);margin-bottom:8px}\n\n/* ---------- 编号大字压底卡片 ---------- */\n.num-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:20px}\n.num-card{position:relative;background:#fff;border:1px solid var(--line);padding:26px 22px 64px;overflow:hidden}\n.num-card .big{position:absolute;right:10px;bottom:-22px;font-size:96px;font-weight:800;color:var(--teal-soft);line-height:1;pointer-events:none}\n.num-card p{font-size:14.5px;color:var(--slate-2);position:relative}\n\n/* ---------- 套餐：纵向列表逐行展开 ---------- */\n.plans{border-top:2px solid var(--slate)}\n.plan-row{border-bottom:1px solid var(--line);background:#fff;padding:28px 24px;display:grid;grid-template-columns:64px 1fr 220px;gap:24px;align-items:start}\n.plan-row.featured{background:var(--teal-soft);border-bottom:2px solid var(--teal)}\n.plan-idx{font-size:40px;font-weight:800;color:var(--line);line-height:1}\n.plan-row.featured .plan-idx{color:var(--teal)}\n.plan-name{font-size:20px;font-weight:800;color:var(--slate);margin-bottom:4px}\n.tag{display:inline-block;font-size:12px;background:var(--teal);color:#fff;padding:2px 10px;margin-left:8px;vertical-align:middle;font-weight:600}\n.plan-desc{font-size:14px;color:var(--slate-3);margin-bottom:12px}\n.plan-feats{list-style:none;font-size:14.5px;color:var(--slate-2)}\n.plan-feats li{padding:3px 0 3px 18px;position:relative}\n.plan-feats li::before{content:\"—\";position:absolute;left:0;color:var(--teal)}\n.plan-price{text-align:right}\n.plan-price .p1{font-size:26px;font-weight:800;color:var(--slate)}\n.plan-price .p2{font-size:13px;color:var(--teal-deep);margin-top:4px}\n.plan-note{font-size:13px;color:var(--slate-3);margin-top:18px}\n\n/* ---------- 使用说明步骤 ---------- */\n.steps{counter-reset:step}\n.step{display:grid;grid-template-columns:56px 1fr;gap:20px;padding:22px 0;border-bottom:1px dashed var(--line)}\n.step::before{counter-increment:step;content:\"0\" counter(step);font-size:26px;font-weight:800;color:var(--teal);line-height:1.2}\n.step:last-child{border-bottom:none}\n.step p{font-size:15px;color:var(--slate-2)}\n\n/* ---------- 客户端 ---------- */\n.clients{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:18px}\n.client{background:#fff;border:1px solid var(--line);padding:22px;position:relative;overflow:hidden}\n.client .big{position:absolute;right:8px;bottom:-18px;font-size:72px;font-weight:800;color:var(--teal-soft);line-height:1}\n.client h3{font-size:16px}\n.client p{font-size:13.5px;color:var(--slate-3);position:relative}\n\n/* ---------- FAQ 编号列表 ---------- */\n.faq-list{counter-reset:faq;border-top:2px solid var(--slate)}\n.faq-item{counter-increment:faq;border-bottom:1px solid var(--line);background:#fff;padding:22px 24px 22px 84px;position:relative}\n.faq-item::before{content:\"Q\" counter(faq);position:absolute;left:24px;top:22px;font-size:20px;font-weight:800;color:var(--teal)}\n.faq-item h3{font-size:16.5px;margin-bottom:6px}\n.faq-item .a{font-size:14.5px;color:var(--slate-2)}\n.faq-item .a::before{content:\"A\";font-weight:800;color:var(--slate-3);margin-right:8px}\n\n/* ---------- 页脚 ---------- */\nfooter{background:var(--slate);color:#9fb0bb;padding:36px 20px;font-size:13px}\nfooter .wrap{display:flex;flex-wrap:wrap;gap:12px 32px;justify-content:space-between}\nfooter b{color:#e6edf1}\n\n@media (max-width:760px){\n  .hero-inner{grid-template-columns:1fr}\n  .hero-blank{display:none}\n  .plan-row{grid-template-columns:1fr}\n  .plan-price{text-align:left}\n  .faq-item{padding-left:64px}\n  .faq-item::before{left:16px}\n}\n</style><div class=\"topbar\">\n  <div class=\"crumbs\"><span>首页</span> / <span>服务说明</span> / <b>千速喵(TSmeow)</b></div>\n  <nav class=\"toc\" aria-label=\"页面目录\">\n    <a href=\"#about\">这是什么</a>\n    <a href=\"#plans\">套餐怎么选</a>\n    <a href=\"#setup\">怎么开始用</a>\n    <a href=\"#clients\">用什么客户端</a>\n    <a href=\"#faq\">还有问题</a>\n  </nav>\n</div>\n\n<main>\n\n\n<header class=\"hero\">\n  <div class=\"hero-inner\">\n    <div>\n      <span class=\"kicker\">TSmeow · 服务说明页</span>\n      <h1>千速喵(TSmeow)<small>先把问题问清楚，再决定要不要订阅</small></h1>\n      <p class=\"lede\">这是一页问答式的说明文档。我们不堆砌形容词，只回答你最关心的几件事：它是什么、三档套餐差在哪、拿到订阅后第一步做什么、手机上电脑上分别装什么。</p>\n      <div class=\"hero-qa\">\n        <p class=\"q\">问：我只想知道多少钱、多少流量？</p>\n        <p>答：基础版 ¥15/月含 100GB，旗舰版 ¥35/月含 300GB，团队版 ¥85/月含 1000GB，按年付均有优惠。细节见下方套餐区。</p>\n        <p class=\"q\">问：完全没接触过这类服务，能看懂吗？</p>\n        <p>答：能。从注册到导入订阅一共四步，本文按顺序写清楚了每一步要做什么。</p>\n      </div>\n      <div class=\"hero-cta\">\n        <a class=\"btn btn-solid\" href=\"#plans\">直接看套餐</a>\n        <a class=\"btn btn-ghost\" href=\"#setup\">先看上手步骤</a>\n      </div>\n    </div>\n    <div class=\"hero-blank\">留白 · 让问题先被看见</div>\n  </div>\n</header>\n\n\n<section id=\"about\">\n  <div class=\"wrap\">\n    <div class=\"sec-head\">\n      <span class=\"no\">SECTION 01</span>\n      <h2>千速喵到底是什么？</h2>\n      <p>用三个最常被问到的问题，把这件事说清楚。</p>\n    </div>\n    <div class=\"num-grid\">\n      <article class=\"num-card\">\n        <h3>它提供什么？</h3>\n        <p>千速喵(TSmeow) 提供按月或按年订阅的网络加速服务。订阅后你会获得一个订阅链接，导入兼容的客户端即可使用，流量额度和设备数由所选套餐决定。</p>\n        <span class=\"big\">01</span>\n      </article>\n      <article class=\"num-card\">\n        <h3>它适合谁？</h3>\n        <p>适合有稳定日常需求、希望按流量档位灵活选择的人。轻度浏览选基础版，追剧和游戏选旗舰版，多人共享或小团队选团队版。</p>\n        <span class=\"big\">02</span>\n      </article>\n      <article class=\"num-card\">\n        <h3>它不适合谁？</h3>\n        <p>如果你只是偶尔用一次、每月流量消耗极低，建议先从基础版按月订阅试起，确认体验符合预期后再考虑年付，避免一次性投入过多。</p>\n        <span class=\"big\">03</span>\n      </article>\n    </div>\n  </div>\n</section>\n\n\n<section id=\"plans\">\n  <div class=\"wrap\">\n    <div class=\"sec-head\">\n      <span class=\"no\">SECTION 02</span>\n      <h2>三档套餐，哪一档是你的？</h2>\n      <p>按流量从小到大逐行展开。不确定的话，先回答自己一个问题：每个月大概用多少流量？</p>\n    </div>\n    <div class=\"plans\">\n      <article class=\"plan-row\">\n        <div class=\"plan-idx\">01</div>\n        <div>\n          <div class=\"plan-name\">基础版</div>\n          <p class=\"plan-desc\">问：只是日常浏览、偶尔看看视频？答：这一档就够了。</p>\n          <ul class=\"plan-feats\">\n            <li>每月 100GB 极速流量</li>\n            <li>支持 3 台设备同时在线</li>\n            <li>解锁基础流媒体</li>\n            <li>普通线路节点池</li>\n          </ul>\n        </div>\n        <div class=\"plan-price\">\n          <div class=\"p1\">¥15/月</div>\n          <div class=\"p2\">按年付仅需 ¥150/年</div>\n        </div>\n      </article>\n      <article class=\"plan-row featured\">\n        <div class=\"plan-idx\">02</div>\n        <div>\n          <div class=\"plan-name\">旗舰版<span class=\"tag\">多数人的选择</span></div>\n          <p class=\"plan-desc\">问：要追高清剧、还要打游戏？答：直接上这一档，流量和线路都更宽裕。</p>\n          <ul class=\"plan-feats\">\n            <li>每月 300GB 极速流量</li>\n            <li>支持 5 台设备同时在线</li>\n            <li>全节点原生流媒体解锁</li>\n            <li>IPLC 专线游戏加速优化</li>\n            <li>7x24 优先工单支持</li>\n          </ul>\n        </div>\n        <div class=\"plan-price\">\n          <div class=\"p1\">¥35/月</div>\n          <div class=\"p2\">按年付仅需 ¥350/年</div>\n        </div>\n      </article>\n      <article class=\"plan-row\">\n        <div class=\"plan-idx\">03</div>\n        <div>\n          <div class=\"plan-name\">团队版</div>\n          <p class=\"plan-desc\">问：多人共用或有定制需求？答：这一档按团队场景设计，配专属对接人。</p>\n          <ul class=\"plan-feats\">\n            <li>每月 1000GB 极速流量</li>\n            <li>支持 20 台设备同时在线</li>\n            <li>VIP 专属高带宽节点</li>\n            <li>支持企业定制路由</li>\n            <li>专属客户经理服务</li>\n          </ul>\n        </div>\n        <div class=\"plan-price\">\n          <div class=\"p1\">¥85/月</div>\n          <div class=\"p2\">按年付仅需 ¥850/年</div>\n        </div>\n      </article>\n    </div>\n    <p class=\"plan-note\">提示：以上为页面所示参考价格，实际以下单页显示为准。流量按月重置，设备数指同时在线数量。</p>\n  </div>\n</section>\n\n\n<section id=\"setup\">\n  <div class=\"wrap\">\n    <div class=\"sec-head\">\n      <span class=\"no\">SECTION 03</span>\n      <h2>从注册到能用，一共几步？</h2>\n      <p>四步。每一步只回答一个问题：这一步我该做什么？</p>\n    </div>\n    <div class=\"steps\">\n      <div class=\"step\">\n        <div>\n          <h3>注册账户</h3>\n          <p>打开千速喵官网，用邮箱注册账户并登录用户中心。建议使用常用邮箱，订单和续费提醒都会发到这里。</p>\n        </div>\n      </div>\n      <div class=\"step\">\n        <div>\n          <h3>选择并购买套餐</h3>\n          <p>对照上方三档套餐，按你的月流量需求选择基础版、旗舰版或团队版，确认月付或年付后完成支付。</p>\n        </div>\n      </div>\n      <div class=\"step\">\n        <div>\n          <h3>复制订阅链接</h3>\n          <p>支付成功后，在用户中心的「我的订阅」页面找到订阅链接，点击复制。这个链接包含你的全部节点信息，请勿泄露给他人。</p>\n        </div>\n      </div>\n      <div class=\"step\">\n        <div>\n          <h3>导入客户端并启用</h3>\n          <p>在你的设备上安装兼容客户端（见下一节），选择「从剪贴板导入」或「添加订阅」，粘贴链接后更新订阅，选择一个节点并开启连接即可。</p>\n        </div>\n      </div>\n    </div>\n  </div>\n</section>\n\n\n<section id=\"clients\">\n  <div class=\"wrap\">\n    <div class=\"sec-head\">\n      <span class=\"no\">SECTION 04</span>\n      <h2>我的设备上装什么？</h2>\n      <p>按你的设备类型对号入座。以下为主流兼容客户端类别，具体下载地址请见千速喵用户中心内的指引。</p>\n    </div>\n    <div class=\"clients\">\n      <article class=\"client\">\n        <h3>Windows / macOS</h3>\n        <p>桌面端选择支持订阅导入的图形化客户端，导入订阅链接后选择节点即可，适合长时间在线的办公和娱乐场景。</p>\n        <span class=\"big\">PC</span>\n      </article>\n      <article class=\"client\">\n        <h3>Android</h3>\n        <p>安卓设备在应用内添加订阅地址，更新后即可看到节点列表，支持按应用分流，日常移动使用很方便。</p>\n        <span class=\"big\">AND</span>\n      </article>\n      <article class=\"client\">\n        <h3>iOS</h3>\n        <p>苹果设备使用支持订阅的客户端 App，粘贴订阅链接完成配置，按提示允许添加配置后即可启用。</p>\n        <span class=\"big\">iOS</span>\n      </article>\n      <article class=\"client\">\n        <h3>路由器 / 其他</h3>\n        <p>进阶用户可在支持的路由器固件中配置订阅，实现全屋设备共享；团队版用户可咨询定制路由方案。</p>\n        <span class=\"big\">RT</span>\n      </article>\n    </div>\n  </div>\n</section>\n\n\n<section id=\"faq\">\n  <div class=\"wrap\">\n    <div class=\"sec-head\">\n      <span class=\"no\">SECTION 05</span>\n      <h2>还有疑问？逐条看</h2>\n      <p>编号排列，找到你问过的那一条。</p>\n    </div>\n    <div class=\"faq-list\">\n      <article class=\"faq-item\">\n        <h3>流量用超了会怎样？</h3>\n        <p class=\"a\">当月流量用尽后服务会暂停，次月自动重置。如果经常不够用，建议直接升级到更高档位，旗舰版的 300GB 对多数重度用户更从容。</p>\n      </article>\n      <article class=\"faq-item\">\n        <h3>一个账户能给几台设备用？</h3>\n        <p class=\"a\">取决于套餐：基础版 3 台、旗舰版 5 台、团队版 20 台同时在线。设备数量指同时连接数，已离线设备不占名额。</p>\n      </article>\n      <article class=\"faq-item\">\n        <h3>月付和年付有什么区别？</h3>\n        <p class=\"a\">服务内容完全相同，年付价格更划算：基础版 ¥150/年、旗舰版 ¥350/年、团队版 ¥850/年，均相当于约十个月的费用。首次使用建议先月付体验。</p>\n      </article>\n      <article class=\"faq-item\">\n        <h3>订阅链接在哪里找？</h3>\n        <p class=\"a\">登录千速喵用户中心，进入「我的订阅」页面即可看到并复制。链接等同于你的账户凭证，不要转发或贴在公开场合。</p>\n      </article>\n      <article class=\"faq-item\">\n        <h3>客户端里看不到节点怎么办？</h3>\n        <p class=\"a\">先在客户端内手动执行一次「更新订阅」；若仍为空，检查订阅链接是否复制完整，或回到用户中心重新复制后再导入一次。</p>\n      </article>\n      <article class=\"faq-item\">\n        <h3>游戏延迟高该选哪一档？</h3>\n        <p class=\"a\">旗舰版包含 IPLC 专线游戏加速优化，是游戏场景的推荐档位；基础版使用普通线路节点池，更适合网页浏览和视频观看。</p>\n      </article>\n      <article class=\"faq-item\">\n        <h3>团队版适合什么场景？</h3>\n        <p class=\"a\">适合多人共享或小团队统一使用：1000GB 月流量、20 台设备同时在线，并提供企业定制路由和专属客户经理对接。</p>\n      </article>\n      <article class=\"faq-item\">\n        <h3>遇到问题怎么联系支持？</h3>\n        <p class=\"a\">在用户中心提交工单即可。旗舰版享有 7x24 优先工单支持，团队版另有专属客户经理服务，响应更快。</p>\n      </article>\n    </div>\n  </div>\n</section>\n\n</main>\n\n<footer>\n  <div class=\"wrap\">\n    <div><b>千速喵(TSmeow)</b> · 订阅服务说明页</div>\n    <div>价格与权益以官方下单页为准 · 请妥善保管你的订阅链接</div>\n  </div>\n</footer>",
